# Copy this file to .env and fill in your Firebase project values.
# Firebase Console → https://console.firebase.google.com/project/nextron-test/settings/general
# → Scroll to "Your apps" → Web App → SDK setup & configuration

VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=nextron-test.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=nextron-test
VITE_FIREBASE_STORAGE_BUCKET=nextron-test.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abc123

# Razorpay — get from https://dashboard.razorpay.com/
VITE_RAZORPAY_KEY_ID=rzp_test_...

# Admin dashboard password (plain string, checked client-side only)
VITE_ADMIN_PASSWORD=nextron26admin
